<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <AssemblyName>cs-rxnet-mini</AssemblyName>
    <RootNamespace>rxnet_mini</RootNamespace>
    <Description>Reactive Extensions (Rx.NET) Observable from scratch</Description>
    <Authors>Mahmoud ElNemer</Authors>
    <PackageProjectUrl>https://github.com/ElNeMeR70/cs-rxnet-mini</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ElNeMeR70/cs-rxnet-mini</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
